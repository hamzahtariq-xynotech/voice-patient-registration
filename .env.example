# Copy to .env and adjust. Never commit the real .env.

# --- Application ---
DATABASE_URL=sqlite:///./data/patients.db
LOG_LEVEL=INFO

# Optional. If set, /vapi/tools and /vapi/events require a matching
# x-vapi-secret header. Pass the same value to scripts/vapi_setup.py --secret.
VAPI_WEBHOOK_SECRET=

# --- Tooling (not used by the running app) ---
# Private API key from the Vapi dashboard, used by scripts/vapi_setup.py.
# The PRIVATE key, not the public one.
VAPI_API_KEY=

# --- Dashboard browser-call widget (optional) ---
# PUBLIC key from the Vapi dashboard -- safe to send to browsers.
# Never put the private key here; /config serves these to the page.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
